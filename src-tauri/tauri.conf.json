{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AI Engine Room",
  "version": "0.1.0",
  "identifier": "com.tartanleaf.aiengineroom",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Engine Room",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "publisher": "Tartanleaf.com Inc.",
    "copyright": "Copyright © 2026 Tartanleaf.com Inc.",
    "license": "Apache-2.0",
    "shortDescription": "Inspect Ollama and LM Studio runtime and resource context.",
    "longDescription": "A pre-release desktop utility for inspecting Ollama and LM Studio runtime and resource context, with explicitly authorized synthetic inference observations.",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
