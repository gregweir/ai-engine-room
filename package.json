{
  "name": "aiengineroom",
  "private": true,
  "version": "0.1.1",
  "description": "A desktop utility for inspecting Ollama and LM Studio runtime and resource context.",
  "author": "Greg Weir",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "AER_LAN_PREVIEW=1 vite",
    "build": "vite build",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "licenses:verify-target": "node scripts/verify-target-license-coverage.mjs",
    "licenses:verify-package": "node scripts/verify-package-license-payload.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "node scripts/repository-readiness.mjs && node scripts/milestone-2c-ubuntu-local-console-helper.test.mjs && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2"
  }
}
